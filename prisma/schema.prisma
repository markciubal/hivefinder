generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERUSER
  MODERATOR
  MEMBER
}

enum ContactType {
  EMAIL
  PHONE
  DISCORD
  OTHER
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InterestSubmissionStatus {
  APPROVED
  REJECTED
}

model User {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  username  String?  @unique
  email     String  @unique
  password  String
  firstName String?
  lastName  String?
  about     String?

  //simple array of interest names for now
  interests String[] @default([])

  resetToken    String?
  resetExpires  DateTime?
  resetLastSent DateTime?

  // role with default MEMBER
  role Role @default(MEMBER)

  // Back-relations
  memberships Member[]       // clubs they belong to
  moderations ClubModerator[] // clubs they moderate
  interestSubmissions InterestSubmission[]
  contactMethods ContactMethod[]
  sentFriendRequests Friendship[] @relation("FriendRequestSender")
  receivedFriendRequests Friendship[] @relation("FriendRequestRecipient")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMethod {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  userId    String      @db.ObjectId
  type      ContactType
  value     String
  label     String?
  preferred Boolean     @default(false)
  visible   Boolean     @default(true)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model InterestSubmission {
  id                 String                   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String                   @db.ObjectId
  interest           String
  normalizedInterest String
  toxicityScore      Float                    @default(0)
  status             InterestSubmissionStatus @default(APPROVED)
  reason             String?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, normalizedInterest])
  @@index([normalizedInterest, status])
}

model Club {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  description   String?
  categories    String[]
  fieldsOfStudy String[]
  points        Int?
  clubUrl       String?

  createdBy     String?  @db.ObjectId     // ← ADDED
  createdAt     DateTime @default(now())  // ← ADDED

  members       Member[]
  moderators    ClubModerator[]
}


model Member {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  clubId String @db.ObjectId

  user User @relation(fields: [userId], references: [id])
  club Club @relation(fields: [clubId], references: [id])

  joinedAt DateTime @default(now())
}

model ClubModerator {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  clubId String @db.ObjectId

  user User @relation(fields: [userId], references: [id])
  club Club @relation(fields: [clubId], references: [id])

  assignedAt DateTime @default(now())
}

model Friendship {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  requesterId String @db.ObjectId
  recipientId String @db.ObjectId
  status FriendshipStatus @default(PENDING)

  requester User @relation("FriendRequestSender", fields: [requesterId], references: [id])
  recipient User @relation("FriendRequestRecipient", fields: [recipientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, recipientId])
  @@index([recipientId])
}
